{
  "manifest_version": 3,
  "name": "canvas-helper",
  "version": "0.5.1",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "description": "在 Canvas Dashboard 查看学期课程介绍与 Panopto 视频状态；在课程视频页批量保存转录稿和可选视频。",
  "minimum_chrome_version": "119",
  "permissions": ["activeTab", "scripting", "downloads", "webRequest"],
  "host_permissions": ["https://*.panopto.com/*", "https://*.panopto.eu/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "canvas-helper · 课程总览与批量下载",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}
  },
  "content_scripts": [{
    "matches": ["https://*.panopto.com/*", "https://*.panopto.eu/*"],
    "js": ["collector.js", "content-script.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
